# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env   then fill in the secrets.
# openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=
LIVEKIT_API_SECRET=
MINIO_ROOT_PASSWORD=

# Public addresses (what browsers use)
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
LIVEKIT_URL=ws://localhost:7880

# Optional
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Jorcord <no-reply@example.com>
# TRUST_PROXY=true            # when behind nginx/Caddy/Traefik
# LIVEKIT_USE_EXTERNAL_IP=true  # on a cloud VM with a public IP
# TENOR_API_KEY=
