# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env   then fill in the secrets.
# openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=
LIVEKIT_API_SECRET=
MINIO_ROOT_PASSWORD=

# Public addresses (what browsers use)
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# auto = signalling goes through the app's own port at /livekit (works for localhost, LAN IP, domain, behind TLS)
LIVEKIT_URL=auto
# Address LiveKit advertises for media; must be reachable from the BROWSER. 127.0.0.1 = browser on the Docker host.
# Other devices on your LAN: this machine's LAN IP.  VPS: leave empty and set LIVEKIT_USE_EXTERNAL_IP=true.
LIVEKIT_NODE_IP=127.0.0.1

# Optional
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Jorcord <no-reply@example.com>
# TRUST_PROXY=true            # when behind nginx/Caddy/Traefik
# LIVEKIT_USE_EXTERNAL_IP=true  # on a cloud VM with a public IP (and LIVEKIT_NODE_IP= empty)
# LIVEKIT_UDP_PORT=7882 and LIVEKIT_UDP_PUBLISH=7882:7882/udp   # single UDP media port instead of 50000-50200
# LIVEKIT_TURN_ENABLED=true and LIVEKIT_TURN_DOMAIN=turn.example.com   # TURN for UDP-blocking networks (TLS: see docs/DEPLOY.md)
# TENOR_API_KEY=
