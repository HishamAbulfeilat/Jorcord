# Jorcord server configuration. Everything has a dev default; copy to .env if you want to override.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Required in production. In dev a random secret is generated and kept in ./data/secret
JWT_SECRET=
# Postgres. If empty, embedded PGlite is used and persisted in ./data/db
DATABASE_URL=
DATA_DIR=./data
# Optional Redis for multi-node pub/sub. If empty, in-memory event bus.
REDIS_URL=
# Comma separated origins, or * (default in dev)
CORS_ORIGINS=*
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_BYTES=
# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# GIF proxy (optional)
TENOR_API_KEY=
GIPHY_API_KEY=

# --- Email (verification + password reset) ---
# smtp://user:pass@host:587 (use smtps:// for implicit TLS). Without it: mails are printed to the log in development
# and NOT sent in production (so password reset is unavailable until SMTP is configured).
SMTP_URL=
MAIL_FROM=Jorcord <no-reply@example.com>

# --- File storage ---
# local (default, DATA_DIR/files) or s3 (AWS S3, MinIO, R2, ...). Files are always served through the Jorcord server.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
# Custom endpoint for MinIO/R2/etc; leave empty for AWS. MinIO needs S3_FORCE_PATH_STYLE=true.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=

# --- Other ---
# Address the *server* uses to reach LiveKit's API when it differs from LIVEKIT_URL (the public URL clients use), e.g. http://livekit:7880 in Docker.
LIVEKIT_API_URL=
# false = never call LiveKit RoomService (server mute/move/disconnect then only update gateway state).
LIVEKIT_CONTROL=true
# auto = Postgres full-text search on pg, ILIKE on embedded PGlite. Force with fts | ilike.
SEARCH_MODE=auto
REDIS_PREFIX=jorcord
VOICE_GRACE_MS=20000
