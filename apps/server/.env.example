# Jorcord server configuration. Everything has a dev default; copy to .env if you want to override.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Required in production. In dev a random secret is generated and kept in ./data/secret
JWT_SECRET=
# Postgres. If empty, embedded PGlite is used and persisted in ./data/db
DATABASE_URL=
DATA_DIR=./data
# Optional Redis for multi-node pub/sub. If empty, in-memory event bus.
REDIS_URL=
# Comma separated origins, or * (default in dev)
CORS_ORIGINS=*
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_BYTES=
# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# GIF proxy (optional)
TENOR_API_KEY=
GIPHY_API_KEY=
