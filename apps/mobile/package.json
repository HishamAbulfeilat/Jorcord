{
  "name": "@jorcord/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Jorcord mobile shell (Capacitor 6, Android + iOS)",
  "scripts": {
    "icons": "node scripts/generate-assets.mjs",
    "sync": "pnpm --filter @jorcord/web build && cap sync",
    "sync:android": "cap sync android",
    "open:android": "cap open android",
    "run:android": "cap run android",
    "build:apk": "pnpm run sync && cd android && ./gradlew assembleRelease",
    "build:aab": "pnpm run sync && cd android && ./gradlew bundleRelease",
    "open:ios": "cap open ios",
    "typecheck": "echo 'mobile: no TS sources'",
    "test": "echo 'mobile: no JS tests'"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.1",
    "@capacitor/haptics": "6.0.2",
    "@capacitor/ios": "6.2.1",
    "@capacitor/keyboard": "6.0.3",
    "@capacitor/local-notifications": "6.1.2",
    "@capacitor/push-notifications": "6.0.3",
    "@capacitor/splash-screen": "6.0.3",
    "@capacitor/status-bar": "6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "sharp": "0.33.5"
  }
}
