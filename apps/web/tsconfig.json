{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "resolveJsonModule": true, "allowImportingTsExtensions": false,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
