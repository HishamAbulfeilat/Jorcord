{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Jorcord main window. Remote (user-configured server) origins get no IPC except notifications. Microphone/camera/screen are webview permissions (see on_permission_request in lib.rs), not IPC capabilities.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-badge-count",
    "core:window:allow-request-user-attention",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "deep-link:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "ms-settings:*" },
        { "url": "x-apple.systempreferences:*" }
      ]
    },
    "window-state:default"
  ]
}
