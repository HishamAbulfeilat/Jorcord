{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jorcord",
  "version": "0.1.0",
  "identifier": "app.jorcord.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @jorcord/web dev",
    "beforeBuildCommand": "pnpm --filter @jorcord/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jorcord",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http://localhost:*",
        "media-src": "'self' blob: mediastream: https: http://localhost:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data: https:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "frame-src": "https:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "category": "SocialNetworking",
    "shortDescription": "Jorcord desktop",
    "longDescription": "Self-hostable chat, voice and video.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["jorcord"] }
    },
    "updater": {
      "active": true,
      "pubkey": "REPLACE_WITH_OUTPUT_OF__tauri_signer_generate",
      "endpoints": ["https://github.com/HishamAbulfeilat/Jorcord/releases/latest/download/latest.json"]
    }
  }
}
